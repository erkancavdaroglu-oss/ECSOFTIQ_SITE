# Uygulamalardaki "Diğer uygulamalarımız" menüsü bu listeyi okur (uygulama içinden erişim için CORS izni)
/uygulamalar/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Geçici: Play Console yüklemesi için paket aktarımı (yükleme bitince klasör silinir)
/yukleme/*
  Access-Control-Allow-Origin: https://play.google.com
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Vakit IQ: uygulama içinden okunan ayar dosyası (yıllık fitre tutarı)
/vakitiq/ayar.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
